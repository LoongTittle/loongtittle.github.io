---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="杨常卿 · 嵌入式工程师" currentPath="/">
  <slot name="head">
    <style>
      /* ===== Hero with animated gradient ===== */
      .hero {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 0;
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(ellipse 80% 50% at 50% 40%, rgba(37,99,235,0.08) 0%, transparent 60%),
          radial-gradient(ellipse 60% 40% at 30% 60%, rgba(124,58,237,0.04) 0%, transparent 50%),
          radial-gradient(ellipse 60% 40% at 70% 50%, rgba(37,99,235,0.04) 0%, transparent 50%),
          var(--bg-primary);
      }

      /* Grid overlay */
      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(37,99,235,0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(37,99,235,0.05) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse 70% 50% at 50% 50%, black 20%, transparent 65%);
        -webkit-mask-image: radial-gradient(ellipse 70% 50% at 50% 50%, black 20%, transparent 65%);
        pointer-events: none;
      }

      .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }

      /* Terminal line */
      .terminal-line {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }
      .terminal-line .prompt { color: var(--success); }
      .terminal-line .cmd { color: var(--text-muted); }
      .terminal-line .cursor {
        display: inline-block;
        width: 8px;
        height: 1.1em;
        background: var(--accent);
        animation: blink 1s step-end infinite;
        vertical-align: text-bottom;
      }
      @keyframes blink {
        50% { opacity: 0; }
      }

      /* Name */
      .hero h1 {
        font-size: clamp(3rem, 8vw, 5rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin-bottom: 1rem;
      }
      .hero .highlight {
        background: linear-gradient(135deg, var(--accent), #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero .tagline {
        font-size: 1.15rem;
        color: var(--text-secondary);
        margin: 0 auto 1.5rem;
        line-height: 1.7;
        max-width: 480px;
      }

      .hero-badges {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
      }
      .hero-badges .badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        transition: all 0.2s;
      }
      .hero-badges .badge:hover {
        border-color: var(--accent-subtle);
        background: var(--accent-light);
        color: var(--accent);
        transform: translateY(-1px);
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* ===== Status banner ===== */
      .status-banner {
        background: linear-gradient(135deg, var(--accent-light), var(--bg-card));
        border: 1px solid var(--accent-subtle);
        border-radius: var(--radius-lg);
        padding: 1.25rem 1.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        box-shadow: var(--shadow-sm);
        margin: -1.5rem auto 2rem;
        position: relative;
        z-index: 2;
        max-width: 700px;
      }
      .status-left { display: flex; align-items: center; gap: 0.75rem; }
      .status-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 0 rgba(22,163,74,0.4);
        animation: breathe 2s infinite;
        flex-shrink: 0;
      }
      @keyframes breathe {
        0%, 100% { box-shadow: 0 0 0 0 rgba(22,163,74,0.4); }
        50% { box-shadow: 0 0 0 8px rgba(22,163,74,0); }
      }
      .status-text { font-size: 0.9rem; font-weight: 500; }
      .status-text small { font-weight: 400; color: var(--text-muted); font-size: 0.8rem; display: block; }

      /* ===== Section ===== */
      .section { padding: 2.5rem 0; }
      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
      }
      .section-header h2 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .section-header .more {
        font-size: 0.82rem;
        color: var(--text-muted);
        transition: color 0.2s;
        font-weight: 500;
      }
      .section-header .more:hover { color: var(--accent); }

      /* ===== Project card ===== */
      .project-card {
        display: block;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 2rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s var(--ease-out);
        position: relative;
        overflow: hidden;
      }
      .project-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), #7c3aed, transparent);
      }
      .project-card:hover {
        box-shadow: var(--shadow-xl);
        transform: translateY(-4px);
      }
      .project-card .label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--accent);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        font-weight: 600;
      }
      .project-card h3 {
        font-size: 1.2rem;
        margin: 0 0 0.5rem;
      }
      .project-card p {
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.7;
      }
      .project-card .tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin: 1rem 0 0;
      }

      /* ===== Divider ===== */
      .section-divider {
        width: 60px; height: 2px;
        margin: 0 auto;
        background: linear-gradient(90deg, transparent, var(--accent-subtle), transparent);
        border: none;
      }

      @media (max-width: 768px) {
        .hero { min-height: auto; padding: 3rem 0; }
      }
    </style>
  </slot>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero-content fade-in-up">
      <div class="terminal-line">
        <span class="prompt">$</span>
        <span class="cmd">whoami</span>
        <span class="cursor"></span>
      </div>

      <h1>
        杨<span class="highlight">常卿</span>
      </h1>

      <p class="tagline">
        嵌入式软件工程师 · 研0<br />
        从学生思维到工程师思维
      </p>

      <div class="hero-badges">
        <span class="badge">STM32</span>
        <span class="badge">C / C++</span>
        <span class="badge">Keil MDK</span>
        <span class="badge">UART</span>
        <span class="badge">SysTick</span>
        <span class="badge">Git</span>
      </div>

      <div class="hero-actions">
        <a href="/resume/" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          查看简历
        </a>
        <a href="/projects/" class="btn btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          浏览项目
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Status ===== -->
  <div class="container">
    <div class="status-banner fade-in delay-1">
      <div class="status-left">
        <span class="status-dot"></span>
        <span class="status-text">
          <small>当前阶段</small>
          研0工程化建设期 · 2026.06 – 2026.09
        </span>
      </div>
      <a href="/about/" class="btn btn-outline" style="font-size:0.8rem;padding:0.35rem 0.9rem;flex-shrink:0;">
        关于我 →
      </a>
    </div>
  </div>

  <hr class="section-divider" />

  <!-- ===== Project ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header fade-in delay-2">
        <h2>/projects</h2>
        <a href="/projects/" class="more">全部 →</a>
      </div>
      <a href="/projects/embedded-lab/" class="project-card fade-in-up delay-2">
        <div class="label">EmbeddedLab</div>
        <h3>串口命令控制 LED 系统</h3>
        <p>基于 STM32F407 的非阻塞 LED 控制系统。串口实时控制、三层模块化架构、UART 中断 + 环形缓冲区 FIFO、SysTick 非阻塞延时。</p>
        <div class="tags">
          <span class="tag">STM32F407</span>
          <span class="tag">C</span>
          <span class="tag">UART</span>
          <span class="tag">SysTick</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

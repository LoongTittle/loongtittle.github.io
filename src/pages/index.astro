---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="杨常卿 · 嵌入式工程师" currentPath="/">
  <slot name="head">
    <style>
      /* ===== Hero ===== */
      .hero {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 0;
        position: relative;
        overflow: hidden;
        background:
          linear-gradient(135deg, rgba(43, 108, 176, 0.03) 0%, transparent 50%),
          linear-gradient(225deg, rgba(43, 108, 176, 0.02) 0%, transparent 50%),
          var(--bg-primary);
      }

      /* subtle grid overlay */
      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(43, 108, 176, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(43, 108, 176, 0.06) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 20%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 20%, transparent 70%);
        pointer-events: none;
      }

      .hero-content {
        position: relative;
        z-index: 1;
      }

      .hero-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent-subtle);
        background: var(--accent-light);
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 1rem;
      }

      .hero .highlight {
        color: var(--accent);
      }

      .hero .subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 520px;
        margin: 0 auto 1.5rem;
        line-height: 1.7;
      }

      .hero-tags {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
      }

      .hero-tags .tag {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.25rem 0.75rem;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* ===== Sections ===== */
      .section { padding: 3rem 0; }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
      }

      .section-header h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
      }

      .section-header .section-arrow {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        transition: color 0.2s;
      }
      .section-header .section-arrow:hover { color: var(--accent); }

      /* ===== Status Bar ===== */
      .status-bar {
        background: linear-gradient(135deg, var(--accent-light), var(--bg-card));
        border: 1px solid var(--accent-subtle);
        border-radius: var(--radius-lg);
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .status-left { display: flex; align-items: center; gap: 1rem; }

      .status-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: var(--success);
        animation: pulse-dot 2s infinite;
        flex-shrink: 0;
      }

      @keyframes pulse-dot {
        0%, 100% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0.4); }
        50% { box-shadow: 0 0 0 6px rgba(47, 158, 68, 0); }
      }

      .status-text { font-size: 0.95rem; font-weight: 500; }
      .status-text small { font-weight: 400; color: var(--text-muted); font-size: 0.85rem; }

      /* ===== Featured Cards ===== */
      .featured-list { display: grid; gap: 1rem; }

      .featured-card {
        display: block;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
      }

      .featured-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 4px; height: 100%;
        background: var(--accent);
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .featured-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
        border-color: var(--accent-subtle);
      }

      .featured-card:hover::before { opacity: 1; }

      .featured-card .card-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-bottom: 0.35rem;
        font-family: var(--font-mono);
      }

      .featured-card h3 {
        font-size: 1.05rem;
        margin: 0 0 0.35rem;
        font-weight: 600;
      }

      .featured-card p {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
      }

      .featured-card .card-footer {
        margin-top: 0.75rem;
        font-size: 0.8rem;
        color: var(--accent);
        font-weight: 500;
      }

      /* ===== Placeholder ===== */
      .placeholder-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .placeholder-card {
        background: var(--bg-card);
        border: 1px dashed var(--border);
        border-radius: var(--radius-md);
        padding: 1.5rem;
        text-align: center;
      }

      .placeholder-card .icon { font-size: 1.5rem; margin-bottom: 0.4rem; opacity: 0.5; }
      .placeholder-card h4 { font-size: 0.9rem; margin: 0 0 0.25rem; font-weight: 500; }
      .placeholder-card p { font-size: 0.8rem; color: var(--text-muted); margin: 0; }

      /* ===== Responsive ===== */
      @media (max-width: 768px) {
        .hero { min-height: auto; padding: 3rem 0; }
        .placeholder-grid { grid-template-columns: 1fr; }
      }
    </style>
  </slot>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-badge">嵌入式工程师 / 研0</div>
      <h1>
        杨<span class="highlight">常卿</span>
      </h1>
      <p class="subtitle">
        从学生思维到工程师思维。<br />
        专注嵌入式系统 · 无人机 · 机器人
      </p>
      <div class="hero-tags">
        <span class="tag">STM32</span>
        <span class="tag">C / C++</span>
        <span class="tag">Keil MDK</span>
        <span class="tag">UART</span>
        <span class="tag">SysTick</span>
      </div>
      <div class="hero-actions">
        <a href="/resume/" class="btn btn-primary">查看简历</a>
        <a href="/projects/" class="btn btn-outline">浏览项目</a>
      </div>
    </div>
  </section>

  <!-- ===== Status ===== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="status-bar">
        <div class="status-left">
          <span class="status-dot"></span>
          <span class="status-text">
            <small>当前阶段</small><br />
            研0工程化建设期 · 2026.06 – 2026.09
          </span>
        </div>
        <a href="/now/" class="btn btn-outline" style="font-size:0.8rem;padding:0.35rem 0.9rem;flex-shrink:0;">
          详情 →
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Featured Projects ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>精选项目</h2>
        <a href="/projects/" class="section-arrow">查看全部 →</a>
      </div>
      <div class="featured-list">
        <a href="/projects/embedded-lab/" class="featured-card">
          <div class="card-label">EmbeddedLab</div>
          <h3>串口命令控制 LED 系统</h3>
          <p>基于 STM32F407 的非阻塞 LED 控制系统。串口实时控制、三层模块化架构（BSP/App/User）、UART 中断 + 环形缓冲区 FIFO、SysTick 非阻塞延时。</p>
          <div class="card-footer">查看项目详情 →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Coming Soon ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>更多内容</h2>
      </div>
      <div class="placeholder-grid">
        <div class="placeholder-card">
          <div class="icon">✎</div>
          <h4>诙谐科普</h4>
          <p>嵌入式技术科普文章 · 即将上线</p>
        </div>
        <div class="placeholder-card">
          <div class="icon">📖</div>
          <h4>技术笔记</h4>
          <p>STM32 外设库笔记 · 即将上线</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

    <div class="content-container">
      <h1>此刻</h1>
      <p style="color:var(--text-secondary); margin-bottom:2rem;">
        当前状态 · 目标 · 正在做的事
      </p>

      <p>内容准备中，敬请期待……</p>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: 3rem 0; }
</style>

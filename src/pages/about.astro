---
import content from '../data/site-content.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我" currentPath="/about">
  <slot name="head">
    <style>
      .page { padding: 3rem 0; }
      .page-head { margin-bottom: 2.5rem; }
      .page-head h1 { margin-bottom: 0.25rem; }
      .page-head .subtitle { color: var(--text-secondary); font-size: 1.05rem; }

      .intro-text { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.8; }
      .intro-text strong { color: var(--text-primary); }

      .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.45rem; }
      .tag-cloud .tag { font-size: 0.82rem; padding: 0.25rem 0.75rem; }
      .tag-cloud .tag-accent { background: var(--accent-light); color: var(--accent); font-weight: 600; }

      .timeline { position: relative; padding-left: 1.75rem; }
      .timeline::before {
        content: '';
        position: absolute; left: 7px; top: 4px; bottom: 4px;
        width: 2px;
        background: linear-gradient(to bottom, var(--accent), var(--accent-subtle), transparent);
        border-radius: 2px;
      }
      .timeline-item {
        position: relative; padding-bottom: 1.5rem;
        padding-left: 0.5rem;
      }
      .timeline-item:last-child { padding-bottom: 0; }
      .timeline-item::before {
        content: '';
        position: absolute; left: -1.75rem; top: 0.4rem;
        width: 16px; height: 16px; border-radius: 50%;
        background: var(--bg-card);
        border: 3px solid var(--accent);
        transform: translateX(-50%);
      }
      .timeline-item.current::before { background: var(--accent); }
      .timeline-item .date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem; color: var(--accent); font-weight: 600;
      }
      .timeline-item h3 { font-size: 1rem; margin: 0.1rem 0 0.2rem; }
      .timeline-item p { font-size: 0.88rem; color: var(--text-secondary); margin: 0; }

      .principle-grid { display: grid; gap: 0.75rem; }
      .principle-card {
        background: var(--bg-card); border: 1px solid var(--border-light);
        border-radius: var(--radius-md); padding: 1.25rem;
        transition: box-shadow 0.2s;
      }
      .principle-card:hover { box-shadow: var(--shadow-sm); }
      .principle-card h3 { font-size: 0.95rem; margin-bottom: 0.25rem; }
      .principle-card p { font-size: 0.85rem; color: var(--text-secondary); margin: 0; }

      .quote-box {
        background: linear-gradient(135deg, var(--accent-light), var(--bg-card));
        border: 1px solid var(--accent-subtle);
        border-radius: var(--radius-md);
        padding: 1.25rem 1.5rem;
        margin-top: 1.25rem;
      }
      .quote-box p { margin: 0; font-style: italic; color: var(--text-secondary); font-size: 0.92rem; }
      .quote-box .attribution { font-style: normal; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem; font-family: 'JetBrains Mono', monospace; }

      @media (max-width: 768px) {
        .page { padding: 2rem 0; }
      }
    </style>
  </slot>

  <div class="page fade-in">
    <div class="content-container">

      <div class="page-head">
        <h1>关于我</h1>
        <div class="subtitle">
          {[content.profile.name, content.profile.role, content.profile.school].filter(Boolean).join(" · ")}
        </div>
      </div>

      <!-- Intro -->
      <div class="page-section">
        <div class="intro-text">
          <p>{content.about.intro}</p>
        </div>
      </div>

      <!-- Tech Stack -->
      <div class="page-section">
        <h2>⚙️ 技术栈</h2>
        <div class="tag-cloud">
          {content.about.skills.split("\n").filter(Boolean).map((skill) => <span class="tag">{skill}</span>)}
        </div>
      </div>

      <!-- Timeline -->
      <div class="page-section">
        <h2>📌 时间线</h2>
        <div class="timeline">
          {content.about.timeline.map(({ date, title, description }) => (
            <div class="timeline-item">
              <div class="date">{date}</div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Principles -->
      <div class="page-section">
        <h2>🧭 原则</h2>
        <div class="principle-grid">
          {content.about.principles.map(({ title, description }) => (
            <div class="principle-card">
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PeripheralProjectCard from '../components/PeripheralProjectCard.astro';
---

<BaseLayout title="项目" currentPath="/projects">
  <slot name="head">
    <style>
      .page { padding: 2.5rem 0; }
      .page h1 { margin-bottom: 1.5rem; }
    </style>
  </slot>

  <div class="page fade-in">
    <div class="content-container">
      <h1>项目</h1>

      <PeripheralProjectCard />
    </div>
  </div>
</BaseLayout>

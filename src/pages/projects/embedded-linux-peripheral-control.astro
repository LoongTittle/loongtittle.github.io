---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { peripheralControl as project } from '../../data/peripheral-control';
---

<BaseLayout title={project.title} currentPath="/projects">
  <article id="peripheral-control-project" class="content-container project">
    <a href="/projects/">← 全部项目</a>
    <h1>{project.title}</h1>
    <p>{project.intro}</p>
    <ul class="stack" aria-label="核心技术栈">
      {project.stack.map((item) => <li class="tag">{item}</li>)}
    </ul>
    <h2>项目实现</h2>
    {project.implementation.map(({ title, description }) => (
      <section>
        <h3>{title}</h3>
        <p>{description}</p>
      </section>
    ))}
    <a class="btn btn-outline" href={project.source}>查看 GitHub 源码</a>
  </article>
</BaseLayout>

<style>
  .project { padding-block: 2.5rem; }
  h1 { margin-block: 1rem; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin-bottom: 2rem; }
  section { margin-block: 1rem; }
</style>

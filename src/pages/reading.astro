---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="阅读" currentPath="/reading">
  <div class="coming-soon fade-in">
    <div class="code-block">{`// 读书笔记
// 技术 · 认知 · 社科 · 文学 · 历史
// 18 本已读 · 精选上线中
//
// Status: 笔记整理中
// ETA: 即将上线

class BookNote {
  constructor(title, insights) {
    this.title = title;
    this.insights = insights;
  }
}`}</div>
    <h1>阅读笔记准备中</h1>
    <p>精选读书笔记正在整理，上线后可按类别浏览。</p>
    <a href="/" class="btn btn-outline" style="margin-top:1rem;">返回首页</a>
  </div>
</BaseLayout>

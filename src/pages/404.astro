---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="section fade-in" style="padding:6rem 0; text-align:center;">
    <div class="content-container">
      <h1 style="font-size:5rem; font-weight:700; color:var(--text-muted); margin-bottom:0.5rem;">404</h1>
      <p style="font-size:1.125rem; color:var(--text-secondary); margin-bottom:2rem;">
        页面不存在或正在建设中
      </p>
      <a href="/" class="btn btn-primary">返回首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: 3rem 0; }
</style>
